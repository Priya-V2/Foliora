# Client
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/foliora?schema=public

# Auth - JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN_SECONDS=1800

# Auth - Refresh Token (rotated on every refresh, stored as SHA-256 hash)
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
REFRESH_TOKEN_ABSOLUTE_LIFETIME_DAYS=90

# Auth - Email Verification / Password Reset tokens
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRES_IN_MINUTES=30

# Auth - Password hashing
BCRYPT_SALT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

# Auth - Cookie
# COOKIE_DOMAIN=.yourdomain.com

# Auth - Rate limiting (scoped to auth endpoints, e.g. login/register/reset)
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_LIMIT=10

# Email - SMTP (for sending verification and password reset emails)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_login
BREVO_SMTP_PASS=your_generated_smtp_key
MAIL_FROM_NAME=Foliora
MAIL_FROM_ADDRESS=no-reply@yourdomain.com

# Email - public app URL used to build links inside outgoing emails
APP_URL=http://localhost:3000

# Gemini API configuration
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# AI - Resume parsing (see server/src/ai)
# AI_PARSER_STRATEGY: pdf_native (send file directly to Gemini) | extracted_text (extract text first)
AI_PARSER_STRATEGY=pdf_native
# AI_BENCHMARK_MODE: runs both strategies and logs a ResumeParseRun for each. Dev/test only - forced off in production.
AI_BENCHMARK_MODE=false